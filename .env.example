# ==============================================================================
# Stream Clips - Environment Configuration Template
# ==============================================================================
# Copy this file to .env to customize local runtime settings.
# All paths and settings are optional; sensible defaults are used if unset.
#
# IMPORTANT: Never commit your actual .env file or credentials to public Git!
# ==============================================================================

# Directory where generated clips, metadata, and caches are stored.
# Default: ~/StreamClips (e.g. C:\Users\<Username>\StreamClips on Windows)
# STREAMCLIPS_HOME=C:\Users\username\StreamClips

# Directory where the private virtual environment and AI models are stored.
# Default: ~/.streamclips (e.g. C:\Users\<Username>\.streamclips on Windows)
# STREAMCLIPS_ENV_HOME=C:\Users\username\.streamclips

# Optional custom public HTTPS URL for Instagram Reels media delivery.
# If omitted, Stream Clips automatically spawns an ephemeral Cloudflare Quick Tunnel
# using the local `cloudflared` binary during publishing.
# Example: https://custom-tunnel.yourdomain.com
# STREAMCLIPS_PUBLIC_URL=

# Enable verbose debug logging for local server and media gateway (0 or 1).
# Default: 0
STREAMCLIPS_DEBUG=0

# Python UTF-8 encoding configuration (recommended on Windows).
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
